#!/usr/bin/env python3
"""
Rewind - Window Grace Period & Undo Restore for Omarchy
Allows closed applications to be rewound/restored within a configurable countdown or manual memory.
"""

import sys
import os
import re
import json
import time
import fcntl
import shutil
import subprocess
import signal
from pathlib import Path

STATE_DIR = Path.home() / ".local" / "state" / "omarchy" / "rewind"
STATE_FILE = STATE_DIR / "state.json"
LOCK_FILE = STATE_DIR / "state.lock"
SPECIAL_WORKSPACE = "special:rewind"
DEFAULT_GRACE_PERIOD = 15.0  # seconds
VERSION = "1.2.0"


def ensure_state_dir():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(STATE_DIR, 0o700)
    except Exception:
        pass


class StateManager:
    def __init__(self):
        ensure_state_dir()
        self.lock_fd = None

    def __enter__(self):
        fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
        self.lock_fd = os.fdopen(fd, "w+")
        fcntl.flock(self.lock_fd, fcntl.LOCK_EX)
        return self._load()

    def __exit__(self, exc_type, exc_val, exc_tb):
        try:
            if self.lock_fd:
                fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
                self.lock_fd.close()
        except Exception:
            pass

    def _load(self):
        if STATE_FILE.exists():
            try:
                with open(STATE_FILE, "r") as f:
                    data = json.load(f)
                    if isinstance(data, dict):
                        data.setdefault("enabled", True)
                        data.setdefault("countdown_enabled", True)
                        data.setdefault("countdown_seconds", int(DEFAULT_GRACE_PERIOD))
                        data.setdefault("pause_media", True)
                        data.setdefault("queue", [])
                        return data
            except Exception:
                pass
        return {
            "enabled": True,
            "countdown_enabled": True,
            "countdown_seconds": int(DEFAULT_GRACE_PERIOD),
            "pause_media": True,
            "queue": []
        }

    def save(self, data):
        tmp = STATE_FILE.with_suffix(".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, STATE_FILE)


def hypr_command(operation: str, cmd: str):
    """Executes a Hyprland Lua command and checks its response."""
    try:
        res = subprocess.run(
            ["hyprctl", operation, cmd],
            capture_output=True,
            text=True,
            timeout=2
        )
        # Lua dispatchers can report an error while hyprctl exits successfully.
        return res.returncode == 0 and res.stdout.strip() == "ok"
    except Exception:
        return False


def hypr_dispatch(cmd: str):
    return hypr_command("dispatch", cmd)


def hypr_eval(cmd: str):
    return hypr_command("eval", cmd)


def get_active_window():
    """Returns active window metadata from hyprctl activewindow -j."""
    try:
        res = subprocess.run(
            ["hyprctl", "activewindow", "-j"],
            capture_output=True,
            text=True,
            timeout=2
        )
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            addr = data.get("address")
            if addr and addr != "0x0" and data.get("mapped", True):
                return data
    except Exception:
        pass
    return None


def get_all_clients():
    """Returns all active client windows."""
    try:
        res = subprocess.run(
            ["hyprctl", "clients", "-j"],
            capture_output=True,
            text=True,
            timeout=2
        )
        if res.returncode == 0 and res.stdout.strip():
            return json.loads(res.stdout)
    except Exception:
        pass
    return []


PROTECTED_COMM = {
    "systemd",
    "init",
    "hyprland",
    "waybar",
    "omarchy-shell",
    "pipewire",
    "wireplumber",
    "dbus-daemon",
    "dbus-broker",
    "steam",
    "steamwebhelper",
    "polkitd",
    "xdg-desktop-por",
    "xdg-desktop-portal",
    "xdg-desktop-portal-hyprland",
    "xwayland",
    "footserver",
}


def get_process_comm(pid: int) -> str:
    """Returns the comm (process name) for a given PID from /proc."""
    try:
        with open(f"/proc/{pid}/comm", "r") as f:
            return f.read().strip()
    except (OSError, IOError):
        return ""


def get_process_tree(root_pid: int) -> set:
    """Finds all descendant PIDs of root_pid by scanning /proc."""
    if not root_pid or not isinstance(root_pid, int) or root_pid <= 1:
        return set()

    ppid_map = {}
    try:
        for entry in os.scandir("/proc"):
            if entry.is_dir() and entry.name.isdigit():
                try:
                    stat_path = os.path.join(entry.path, "stat")
                    with open(stat_path, "r") as f:
                        content = f.read()
                    rparen = content.rfind(")")
                    if rparen != -1:
                        parts = content[rparen + 1:].split()
                        ppid = int(parts[1])
                        ppid_map.setdefault(ppid, []).append(int(entry.name))
                except (OSError, IOError, IndexError, ValueError):
                    pass
    except OSError:
        pass

    descendants = set()
    queue = [root_pid]
    while queue:
        curr = queue.pop()
        for child in ppid_map.get(curr, []):
            if child not in descendants and child > 1:
                descendants.add(child)
                queue.append(child)

    return descendants


def terminate_window(addr: str, pid: int = None):
    """
    Permanently and reliably terminates a window and its process tree:
    1. Attempts graceful close via hl.dsp.window.close.
    2. If the window surface remains after polling, force-kills it via hl.dsp.window.kill.
    3. If the process is still running and owns no other open windows, cleanly terminates
       it and its descendant processes (SIGTERM, then SIGKILL if still alive).
    """
    if not addr:
        return

    # Check current compositor clients
    all_clients = get_all_clients()
    target_client = next((c for c in all_clients if c.get("address") == addr), None)
    if pid is None and target_client:
        pid = target_client.get("pid")

    client_class = target_client.get("class", "") if target_client else ""
    prepare_window_audio_for_close({"address": addr, "pid": pid, "class": client_class})

    if target_client is not None:
        # Phase 1: Graceful close request
        hypr_dispatch(f'hl.dsp.window.close({{ window = "address:{addr}" }})')

        # Check / poll to see if window closed gracefully (up to 2.0s)
        closed = not any(c.get("address") == addr for c in get_all_clients())
        if not closed:
            for _ in range(40):
                time.sleep(0.05)
                if not any(c.get("address") == addr for c in get_all_clients()):
                    closed = True
                    break

        # Phase 2: Force-kill via compositor if still present
        if not closed:
            hypr_dispatch(f'hl.dsp.window.kill({{ window = "address:{addr}" }})')
            closed = not any(c.get("address") == addr for c in get_all_clients())
            if not closed:
                for _ in range(10):
                    time.sleep(0.05)
                    if not any(c.get("address") == addr for c in get_all_clients()):
                        closed = True
                        break

    # Phase 3: Process tree cleanup
    if pid and isinstance(pid, int) and pid > 1 and pid != os.getpid() and pid != os.getppid():
        # Safety check: do not kill if another open window shares this PID
        remaining = get_all_clients()
        shares_pid = any(c.get("address") != addr and c.get("pid") == pid for c in remaining)
        if not shares_pid:
            comm = get_process_comm(pid).lower()
            if comm not in PROTECTED_COMM:
                try:
                    os.kill(pid, 0)
                    is_alive = True
                except (ProcessLookupError, OSError):
                    is_alive = False

                if is_alive:
                    descendants = get_process_tree(pid)
                    targets = descendants | {pid}

                    # Attempt graceful SIGTERM first
                    for p in targets:
                        try:
                            os.kill(p, signal.SIGTERM)
                        except (ProcessLookupError, OSError):
                            pass

                    # Wait for graceful SIGTERM exit (up to 1.0s, polling every 0.1s)
                    still_alive = set(targets)
                    for _ in range(10):
                        time.sleep(0.1)
                        alive_now = set()
                        for p in still_alive:
                            try:
                                os.kill(p, 0)
                                alive_now.add(p)
                            except (ProcessLookupError, OSError):
                                pass
                        still_alive = alive_now
                        if not still_alive:
                            break

                    # Force kill with SIGKILL only if any processes remain alive after SIGTERM timeout
                    if still_alive:
                        for p in still_alive:
                            try:
                                os.kill(p, signal.SIGKILL)
                            except (ProcessLookupError, OSError):
                                pass


def restore_window_group(target: dict):
    """Rejoin a surviving original group at the saved position."""
    addr = target["address"]
    members = target.get("group_members", [])
    if addr not in members or len(members) < 2:
        return False

    original_index = members.index(addr)
    clients = {client["address"]: client for client in get_all_clients()}
    # Prefer a nearby surviving member. Ignore other windows still in Rewind.
    peers = list(reversed(members[:original_index])) + members[original_index + 1:]
    for peer_addr in peers:
        peer = clients.get(peer_addr)
        if not peer or peer.get("workspace", {}).get("name") == SPECIAL_WORKSPACE:
            continue
        group = peer.get("grouped", [])
        if not group:
            continue

        # Preserve the position relative to surviving original neighbours.
        # With an unchanged group this is exactly the original tab index.
        before = next((member for member in reversed(members[:original_index]) if member in group), None)
        after = next((member for member in members[original_index + 1:] if member in group), None)
        if before:
            index = group.index(before) + 1
        elif after:
            index = group.index(after)
        else:
            index = min(original_index, len(group))

        # Group:add accepts an explicit one-based index and moves the window
        # directly onto the group's workspace, without moving any peers.
        # Temporarily release a local lock, then restore its current state,
        # even if adding the window fails. Global locks remain in effect.
        return hypr_eval(f'''
local window = hl.get_window("address:{addr}")
local peer = hl.get_window("address:{peer_addr}")
assert(window and peer and peer.group, "Original group no longer exists")
local group = peer.group
assert(not window.group, "Saved window is already grouped")
local locked = group.locked
if locked then
    hl.dispatch(hl.dsp.focus({{ window = peer }}))
    hl.dispatch(hl.dsp.group.lock_active({{ action = "disable" }}))
end
local ok, err = pcall(function()
    group:add(window, math.min({index + 1}, group.size + 1))
end)
if locked then
    hl.dispatch(hl.dsp.focus({{ window = peer }}))
    hl.dispatch(hl.dsp.group.lock_active({{ action = "enable" }}))
end
assert(ok, err)
assert(window.group == group, "Could not restore original group")
''')

    return False


def show_osd(icon: str, message: str, duration: int = 1500):
    """Summons the native Omarchy OSD."""
    payload = json.dumps({"icon": icon, "message": message, "duration": duration})
    try:
        subprocess.run(
            ["omarchy-shell", "shell", "summon", "omarchy.osd", payload],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
    except Exception:
        pass


def notify_shell_widget():
    """Notifies Omarchy bar widget to refresh its display."""
