        subprocess.run(
            ["omarchy-shell", "-q", "omarchy.rewind", "refresh"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
    except Exception:
        pass


def get_process_ancestors(pid: int) -> set:
    """Returns the set of ancestor PIDs for a given PID."""
    ancestors = set()
    curr = pid
    while curr > 1:
        ancestors.add(curr)
        try:
            with open(f"/proc/{curr}/stat", "r") as f:
                content = f.read()
                ppid = int(content.split(")")[-1].split()[1])
                if ppid == curr or ppid <= 0:
                    break
                curr = ppid
        except Exception:
            break
    return ancestors


def are_pids_related(pid1: int, pid2: int) -> bool:
    """Checks if two PIDs are in the same process family / tree."""
    if pid1 == pid2:
        return True
    if pid1 <= 1 or pid2 <= 1:
        return False
    try:
        a1 = get_process_ancestors(pid1)
        a2 = get_process_ancestors(pid2)
        if pid1 in a2 or pid2 in a1:
            return True
        common = a1.intersection(a2)
        common.discard(1)
        return len(common) > 0
    except Exception:
        return False


def get_mpris_players() -> list:
    """Discovers active MPRIS D-Bus player services on the session bus."""
    try:
        res = subprocess.run(
            ["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "ListNames"],
            capture_output=True,
            text=True,
            timeout=0.5
        )
        if res.returncode == 0:
            return re.findall(r'"(org\.mpris\.MediaPlayer2\.[^"]+)"', res.stdout)
    except Exception:
        pass
    return []


def get_player_pid(service_name: str) -> int:
    """Queries D-Bus for the UNIX PID of the given service name."""
    try:
        res = subprocess.run(
            ["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetConnectionUnixProcessID", "s", service_name],
            capture_output=True,
            text=True,
            timeout=0.5
        )
        if res.returncode == 0:
            parts = res.stdout.strip().split()
            if len(parts) >= 2 and parts[0] == "u":
                return int(parts[1])
    except Exception:
        pass
    return -1


def get_player_status(service_name: str) -> str:
    """Returns 'Playing', 'Paused', 'Stopped', or '' for the player."""
    try:
        res = subprocess.run(
            ["busctl", "--user", "get-property", service_name, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus"],
            capture_output=True,
            text=True,
            timeout=0.5
        )
        if res.returncode == 0:
            m = re.search(r's\s+"([^"]+)"', res.stdout)
            if m:
                return m.group(1)
    except Exception:
        pass
    return ""


def pause_window_media(window_data: dict):
    """If media is actively playing in the window being closed, pauses it and returns player service name."""
    if not window_data:
        return None

    win_pid = window_data.get("pid", -1)
    win_class = (window_data.get("class") or "").lower()

    players = get_mpris_players()
    if not players:
        return None

    for player in players:
        try:
            status = get_player_status(player)
            if status != "Playing":
                continue

            player_pid = get_player_pid(player)
            is_match = False

            # 1. Direct PID match (Spotify, VLC, MPV, music players, etc.)
            if win_pid > 0 and player_pid == win_pid:
                is_match = True
            # 2. Process tree relationship (Browser renderers/audio helper processes)
            elif win_pid > 0 and player_pid > 0 and are_pids_related(win_pid, player_pid):
                is_match = True
            # 3. Application class match fallback (e.g. "spotify" in "org.mpris.MediaPlayer2.spotify")
            elif win_class and win_class in player.lower():
                is_match = True

            if is_match:
                subprocess.run(
                    ["busctl", "--user", "call", player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Pause"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=0.5
                )
                return player
        except Exception:
            continue

    return None


def resume_window_media(player_service: str):
    """Sends a Play signal to resume playback on the specified player service."""
    if not player_service:
        return
    try:
        subprocess.run(
            ["busctl", "--user", "call", player_service, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Play"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.5
        )
    except Exception:
        pass


def get_window_audio_streams(target_pids: set, win_class: str = "") -> tuple[set, set]:
    """Returns (node_ids, pactl_indices) matching the target PIDs or window class."""
    node_ids = set()
    pactl_indices = set()

    # 1. PipeWire / WirePlumber (native nodes)
    try:
        res = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=0.8)
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            client_to_pid = {}
            for item in data:
                if item.get("type") == "PipeWire:Interface:Client":
                    props = item.get("info", {}).get("props", {})
                    pid = props.get("application.process.id") or props.get("pipewire.sec.pid")
                    if pid:
                        try:
                            client_to_pid[item.get("id")] = int(pid)
                        except (ValueError, TypeError):
                            pass

            for item in data:
                if item.get("type") == "PipeWire:Interface:Node":
                    props = item.get("info", {}).get("props", {})
                    if props.get("media.class") == "Stream/Output/Audio":
                        node_id = item.get("id")
                        client_id = props.get("client.id")
                        stream_pid = props.get("application.process.id") or client_to_pid.get(client_id)
                        try:
                            stream_pid = int(stream_pid) if stream_pid is not None else None
                        except (ValueError, TypeError):
                            stream_pid = None

                        app_name = (props.get("application.name") or props.get("node.name") or "").lower()
                        binary = (props.get("application.process.binary") or "").lower()

                        is_match = False
                        if stream_pid and stream_pid in target_pids:
                            is_match = True
                        elif win_class and (win_class == app_name or win_class == binary):
                            is_match = True

                        if is_match and node_id:
                            node_ids.add(node_id)
    except Exception:
        pass

    # 2. PulseAudio / pactl (sink-inputs)
    try:
        res = subprocess.run(["pactl", "list", "sink-inputs"], capture_output=True, text=True, timeout=0.8)
        if res.returncode == 0:
            curr_idx = None
            curr_pid = None
            curr_name = ""
            for line in res.stdout.splitlines():
                line = line.strip()
                m = re.match(r"^Sink Input #(\d+)", line)
                if m:
                    if curr_idx is not None:
                        if (curr_pid and curr_pid in target_pids) or (win_class and win_class in curr_name.lower()):
                            pactl_indices.add(curr_idx)
                    curr_idx = int(m.group(1))
                    curr_pid = None
                    curr_name = ""
                elif "application.process.id =" in line:
                    val = line.split("=")[-1].strip().strip('"')
                    if val.isdigit():
                        curr_pid = int(val)
                elif "application.name =" in line or "application.process.binary =" in line:
                    curr_name += " " + line.split("=")[-1].strip().strip('"')
            if curr_idx is not None:
                if (curr_pid and curr_pid in target_pids) or (win_class and win_class in curr_name.lower()):
                    pactl_indices.add(curr_idx)
    except Exception:
        pass

    return node_ids, pactl_indices


def mute_window_audio(window_data: dict) -> dict:
    """Mutes active PipeWire and PulseAudio streams for the window process tree."""
    if not window_data:
        return None
    win_pid = window_data.get("pid", -1)
    win_class = (window_data.get("class") or "").lower()
    target_pids = ({win_pid} | get_process_tree(win_pid)) if win_pid and win_pid > 0 else set()

    nodes, pactl_idxs = get_window_audio_streams(target_pids, win_class)
    for node_id in nodes:
        subprocess.run(["wpctl", "set-mute", str(node_id), "1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
    for idx in pactl_idxs:
        subprocess.run(["pactl", "set-sink-input-mute", str(idx), "1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)

    if nodes or pactl_idxs:
        return {"nodes": list(nodes), "pactl": list(pactl_idxs)}
    return None


def unmute_window_audio(target: dict):
    """Unmutes audio streams for the restored window."""
    if not target:
        return
    win_pid = target.get("pid", -1)
    win_class = (target.get("class") or "").lower()
    target_pids = ({win_pid} | get_process_tree(win_pid)) if win_pid and win_pid > 0 else set()

    # Unmute recorded nodes & pactl streams
    muted_info = target.get("muted_audio") or {}
    nodes_to_unmute = set(muted_info.get("nodes", []))
    pactl_to_unmute = set(muted_info.get("pactl", []))

    # Also discover and unmute any currently active streams for this window
    curr_nodes, curr_pactl = get_window_audio_streams(target_pids, win_class)
    nodes_to_unmute.update(curr_nodes)
    pactl_to_unmute.update(curr_pactl)

    for node_id in nodes_to_unmute:
        subprocess.run(["wpctl", "set-mute", str(node_id), "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
    for idx in pactl_to_unmute:
        subprocess.run(["pactl", "set-sink-input-mute", str(idx), "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)


def prepare_window_audio_for_close(target: dict):
    """
    Prepares window audio streams before permanent termination:
    1. Sever active PipeWire links to output sinks so unmuting causes zero audible sound leakage.
    2. Unmute PipeWire nodes and PulseAudio sink-inputs while the process is still alive,
       so WirePlumber and PulseAudio stream-restore record the stream as unmuted (mute: false).
       This ensures subsequent fresh launches of the application start unmuted.
    3. Sanitize WirePlumber stream-properties on disk if any lingering mute flags exist.
    """
    if not target or not isinstance(target, dict):
        return

    win_pid = target.get("pid", -1)
    win_class = (target.get("class") or "").lower()
    if not win_class and win_pid and isinstance(win_pid, int) and win_pid > 0:
        win_class = get_process_comm(win_pid).lower()

    target_pids = ({win_pid} | get_process_tree(win_pid)) if win_pid and isinstance(win_pid, int) and win_pid > 0 else set()

    # Streams previously recorded when muted + any active streams currently open
    muted_info = target.get("muted_audio") or {}
    node_ids = set(muted_info.get("nodes", []))
    pactl_idxs = set(muted_info.get("pactl", []))

    curr_nodes, curr_pactl = get_window_audio_streams(target_pids, win_class)
    node_ids.update(curr_nodes)
    pactl_idxs.update(curr_pactl)

    # 1. Disconnect active output links so unmuting doesn't cause an audio pop or burst
    if node_ids:
        try:
            res = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=0.8)
            if res.returncode == 0 and res.stdout.strip():
                data = json.loads(res.stdout)
                for item in data:
                    if item.get("type") == "PipeWire:Interface:Link":
                        props = item.get("info", {}).get("props", {})
                        if props.get("link.output.node") in node_ids:
                            link_id = item.get("id")
                            if link_id:
                                subprocess.run(
                                    ["pw-cli", "destroy", str(link_id)],
                                    stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL,
                                    timeout=0.5
                                )
        except Exception:
            pass

    # 2. Unmute nodes and sink-inputs so stream-restore saves mute: false
    for node_id in node_ids:
        subprocess.run(["wpctl", "set-mute", str(node_id), "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
    for idx in pactl_idxs:
        subprocess.run(["pactl", "set-sink-input-mute", str(idx), "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)

    # 3. Sanitize WirePlumber stream-properties file on disk
    try:
        wp_prop_file = Path.home() / ".local" / "state" / "wireplumber" / "stream-properties"
        if wp_prop_file.exists():
            content = wp_prop_file.read_text(encoding="utf-8")
            if '"mute":true' in content or '"mute": true' in content:
                new_lines = []
                changed = False
                norm_class = win_class.lower().strip()
                for line in content.splitlines():
                    if '"mute":true' in line or '"mute": true' in line:
                        norm_line = line.lower().replace(r"\s", " ").replace(r"\o", "").replace(r"\c", "")
                        match_class = (not norm_class) or (norm_class in norm_line) or (norm_class.replace("-", " ") in norm_line) or (norm_class.replace("_", " ") in norm_line)
                        if match_class:
                            line = line.replace('"mute":true', '"mute":false').replace('"mute": true', '"mute": false')
                            changed = True
                    new_lines.append(line)
                if changed:
                    wp_prop_file.write_text("\n".join(new_lines) + "\n", encoding="utf-8")
    except Exception:
        pass


def flush_workspace_focus(ws_name: str = None):
    """Ensures Hyprland does not keep a hidden window as the active window,
    and ensures special:rewind is closed so it never unexpectedly re-opens."""
    return hypr_eval(f'''
local spec = hl.get_active_special_workspace()
if spec and spec.name == "{SPECIAL_WORKSPACE}" then
    hl.dispatch(hl.dsp.workspace.toggle_special("rewind"))
end

local curr_ws = hl.get_active_workspace()
local remaining = hl.get_workspace_windows(curr_ws)
if remaining and #remaining > 0 then
    hl.dispatch(hl.dsp.focus({{ window = remaining[1] }}))
else
    local curr_name = curr_ws.name
    local other = (curr_name == "1") and "2" or "1"
    hl.dispatch(hl.dsp.focus({{ workspace = other }}))
    hl.dispatch(hl.dsp.focus({{ workspace = curr_name }}))
end
''')


def action_close():
    """Handles Super+W close request."""
    sm = StateManager()
    spawn_worker = False
    worker_addr = None
    worker_now = None
    worker_duration = None

    with sm as state:
        enabled = state.get("enabled", True)
        if not enabled:
            # Feature is disabled: perform standard immediate close
            hypr_dispatch("hl.dsp.window.close()")
            return

        active = get_active_window()
        if not active:
            # No active window to close
            hypr_dispatch("hl.dsp.window.close()")
            return

        addr = active["address"]
        ws = active.get("workspace", {})
        ws_name = str(ws.get("name", ws.get("id", "1")))
        title = active.get("title", "") or active.get("class", "Window")
        app_class = active.get("class", "")
        group_members = active.get("grouped", [])

        # If window is already on special:rewind:
        # If managed in the Rewind queue, hide the workspace and renew grace period rather than destroying it.
        if ws_name == SPECIAL_WORKSPACE:
            queue = state.get("queue", [])
            in_queue = any(item.get("address") == addr for item in queue)
            if in_queue:
                flush_workspace_focus(ws_name)
                countdown_enabled = state.get("countdown_enabled", True)
                countdown_seconds = state.get("countdown_seconds", int(DEFAULT_GRACE_PERIOD))
                now = time.time()
                for item in queue:
                    if item.get("address") == addr:
                        if countdown_enabled:
                            item["expires_at"] = now + countdown_seconds
                            spawn_worker = True
                            worker_addr = addr
                            worker_now = str(now)
                            worker_duration = str(countdown_seconds)
                        if "pid" not in item and active.get("pid"):
                            item["pid"] = active.get("pid")
                        break
                state["queue"] = queue
                sm.save(state)
                if countdown_enabled:
                    show_osd("󰁯", f"Rewind: {countdown_seconds}s grace", 1500)
                else:
                    show_osd("󰁯", "Rewind: Saved (Super+U to restore)", 1500)
                notify_shell_widget()
                if spawn_worker:
                    subprocess.Popen(
                        [sys.executable, __file__, "--expire", worker_addr, worker_now, worker_duration],
                        start_new_session=True,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL
                    )
                return
            else:
                terminate_window(addr, active.get("pid"))
                return

        # Detach and hide in one compositor request so the temporary tile is
        # never rendered. Keep the hidden tab floating at its original geometry:
        # tiling it on the special workspace would enlarge it, then animate that
        # larger rectangle back over the group when restored.
        if group_members:
            move_success = hypr_eval(f'''
local window = hl.get_window("address:{addr}")
assert(window, "Saved window no longer exists")
local at, size = window.at, window.size
hl.dispatch(hl.dsp.window.move({{ window = window, out_of_group = true }}))
assert(not window.group, "Could not detach window from group")
hl.dispatch(hl.dsp.window.float({{ window = window, action = "enable" }}))
hl.dispatch(hl.dsp.window.move({{ window = window, workspace = "{SPECIAL_WORKSPACE}", follow = false }}))
hl.dispatch(hl.dsp.window.resize({{ window = window, x = size.x, y = size.y, relative = false }}))
hl.dispatch(hl.dsp.window.move({{ window = window, x = at.x, y = at.y, relative = false }}))
assert(window.workspace.name == "{SPECIAL_WORKSPACE}", "Could not hide window")
''')
            if not move_success:
                show_osd("󰅖", "Rewind: Could not save grouped window", 1500)
                return
        else:
            # Move silently to special:rewind
            move_success = hypr_dispatch(
                f'hl.dsp.window.move({{ window = "address:{addr}", workspace = "{SPECIAL_WORKSPACE}", follow = false }})'
            )
            if not move_success:
                terminate_window(addr, active.get("pid"))
                return

        flush_workspace_focus(ws_name)

        # Pause playing media and mute window audio if feature is enabled
        paused_media = None
        muted_audio = None
        if state.get("pause_media", True):
            paused_media = pause_window_media(active)
            muted_audio = mute_window_audio(active)

        now = time.time()
        countdown_enabled = state.get("countdown_enabled", True)
        countdown_seconds = state.get("countdown_seconds", int(DEFAULT_GRACE_PERIOD))
        queue = state.get("queue", [])

        if not countdown_enabled:
            # Manual mode: countdown is disabled.
            # Replace previous hidden window by permanently closing it
            for old in queue:
                old_addr = old.get("address")
                if old_addr and old_addr != addr:
                    prepare_window_audio_for_close(old)
                    terminate_window(old_addr, old.get("pid"))

            queue = []
            record = {
                "address": addr,
                "workspace": ws_name,
                "title": title,
                "class": app_class,
                "pid": active.get("pid"),
                "timestamp": now,
                "expires_at": None,
                "paused_media": paused_media,
                "muted_audio": muted_audio,
                "group_members": group_members,
                "group_floating": active.get("floating", False)
            }
            queue.append(record)
            state["queue"] = queue
            sm.save(state)
            if paused_media:
                show_osd("󰝚", "Rewind: Saved (Media paused)", 1500)
            elif muted_audio:
                show_osd("󰝟", "Rewind: Saved (Audio muted)", 1500)
            else:
                show_osd("󰁯", "Rewind: Saved (Super+U to restore)", 1500)
        else:
            # Countdown mode
            queue = [item for item in queue if item["address"] != addr]
            expires_at = now + countdown_seconds
            record = {
                "address": addr,
                "workspace": ws_name,
                "title": title,
                "class": app_class,
                "pid": active.get("pid"),
                "timestamp": now,
                "expires_at": expires_at,
                "paused_media": paused_media,
                "muted_audio": muted_audio,
                "group_members": group_members,
                "group_floating": active.get("floating", False)
            }
            queue.append(record)
            state["queue"] = queue
            sm.save(state)

            spawn_worker = True
            worker_addr = addr
            worker_now = str(now)
            worker_duration = str(countdown_seconds)
            if paused_media:
                show_osd("󰝚", f"Rewind: {countdown_seconds}s grace (Media paused)", 1500)
            elif muted_audio:
                show_osd("󰝟", f"Rewind: {countdown_seconds}s grace (Audio muted)", 1500)
            else:
                show_osd("󰁯", f"Rewind: {countdown_seconds}s grace", 1500)

    if spawn_worker:
        subprocess.Popen(
            [sys.executable, __file__, "--expire", worker_addr, worker_now, worker_duration],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

    notify_shell_widget()


def action_expire(addr: str, timestamp_str: str, duration_str: str):
    """Background worker that permanently closes the window after the countdown."""
    try:
        duration = float(duration_str)
    except ValueError:
        duration = DEFAULT_GRACE_PERIOD

    time.sleep(duration)
    try:
        ts = float(timestamp_str)
    except ValueError:
        return

    sm = StateManager()
    with sm as state:
        if not state.get("countdown_enabled", True):
            # Mode changed to manual during grace period; do not expire
            return

        queue = state.get("queue", [])
        matching = [item for item in queue if item["address"] == addr and abs(item["timestamp"] - ts) < 0.05]
        if not matching:
            # Window was already restored or replaced
            return

        target = matching[0]
        expires_at = target.get("expires_at")
        if expires_at is None or time.time() < (expires_at - 0.2):
            # Expiration was cancelled or deadline was extended
            return

        target_pid = target.get("pid")

        # Remove from queue
        state["queue"] = [item for item in queue if not (item["address"] == addr and abs(item["timestamp"] - ts) < 0.05)]
        sm.save(state)

    # Permanently close window and cleanup process tree
    prepare_window_audio_for_close(target)
    terminate_window(addr, target_pid)

    notify_shell_widget()


def action_restore():
    """Restores the most recently closed/hidden window from special:rewind."""
    sm = StateManager()
    target = None
    with sm as state:
        queue = state.get("queue", [])
        now = time.time()
        countdown_enabled = state.get("countdown_enabled", True)

        if countdown_enabled:
            # Clean up stale items that passed expiration
            queue = [item for item in queue if item.get("expires_at") and item.get("expires_at", 0) > now]

        if not queue:
            state["queue"] = []
            sm.save(state)
            show_osd("󰁪", "Nothing to rewind", 1200)
            notify_shell_widget()
            return

        target = queue.pop()
        state["queue"] = queue
        sm.save(state)

    if not target:
        return

    addr = target["address"]
    ws = target["workspace"]

    # Rejoin the original group directly, or restore to the workspace if it
    # disappeared. Old queue records without group metadata remain compatible.
    group_ok = restore_window_group(target)
    move_ok = group_ok
    if not move_ok:
        # A saved tiled tab was floated only while hidden. If its group is gone,
        # restore its original tiling mode before returning it to the workspace.
        if target.get("group_members") and not target.get("group_floating", False):
            hypr_dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "disable" }})')
        move_ok = hypr_dispatch(
            f'hl.dsp.window.move({{ window = "address:{addr}", workspace = "{ws}", follow = true }})'
        )
        if move_ok and target.get("group_members") == [addr]:
            group_ok = hypr_dispatch(f'hl.dsp.group.toggle({{ window = "address:{addr}" }})')
    hypr_dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')

    # Ensure special:rewind is closed if it was left active
    hypr_eval(f'''
local spec = hl.get_active_special_workspace()
if spec and spec.name == "{SPECIAL_WORKSPACE}" then
    hl.dispatch(hl.dsp.workspace.toggle_special("rewind"))
end
''')

    # Resume media playback if it was paused when closed
    paused_player = target.get("paused_media")
    if paused_player:
        resume_window_media(paused_player)

    # Unmute window audio streams if any were muted
    muted_audio = target.get("muted_audio")
    if muted_audio:
        unmute_window_audio(target)

    if move_ok:
        if target.get("group_members") and not group_ok:
            show_osd("󰁪", "Rewound window (Group unavailable)", 1500)
        elif paused_player:
            show_osd("󰝚", "Rewound window (Media resumed)", 1500)
        elif muted_audio:
            show_osd("󰕾", "Rewound window (Audio unmuted)", 1500)
        else:
            show_osd("󰁪", "Rewound window", 1500)
    else:
        show_osd("󰁪", "Window no longer running", 1200)

    notify_shell_widget()


def action_toggle():
    """Toggles the Rewind feature ON/OFF with OSD display."""
    sm = StateManager()
    to_terminate = []
    with sm as state:
        current = state.get("enabled", True)
        new_val = not current
        state["enabled"] = new_val

        # If turning OFF, permanently close any currently queued windows
        if not new_val:
            for item in state.get("queue", []):
                addr = item.get("address")
                if addr:
                    to_terminate.append(item)
            state["queue"] = []

        sm.save(state)

    for item in to_terminate:
        prepare_window_audio_for_close(item)
        terminate_window(item.get("address"), item.get("pid"))

    if new_val:
        show_osd("󰁯", "Rewind: ON", 1500)
    else:
        show_osd("󰁯", "Rewind: OFF", 1500)

    notify_shell_widget()


def action_config(args):
    """Configures duration and countdown toggle."""
    sm = StateManager()
    with sm as state:
        if "--duration" in args:
            idx = args.index("--duration")
            if idx + 1 < len(args):
                try:
                    val = max(1, int(args[idx + 1]))
                    state["countdown_seconds"] = val
                    state["countdown_enabled"] = True
                    now = time.time()
                    for item in state.get("queue", []):
                        item["expires_at"] = now + val
                    show_osd("󰁯", f"Rewind Timer: {val}s", 1500)
                except ValueError:
                    pass
        elif "--disable-countdown" in args or "--countdown-off" in args:
            state["countdown_enabled"] = False
            for item in state.get("queue", []):
                item["expires_at"] = None
            show_osd("󰁯", "Rewind: Manual Mode", 1500)
        elif "--enable-countdown" in args or "--countdown-on" in args:
            state["countdown_enabled"] = True
            val = state.get("countdown_seconds", 15)
            now = time.time()
            for item in state.get("queue", []):
                item["expires_at"] = now + val
            show_osd("󰁯", f"Rewind Timer: {val}s", 1500)
        elif "--toggle-countdown" in args:
            curr = state.get("countdown_enabled", True)
            new_val = not curr
            state["countdown_enabled"] = new_val
            if new_val:
                val = state.get("countdown_seconds", 15)
                now = time.time()
                for item in state.get("queue", []):
                    item["expires_at"] = now + val
                show_osd("󰁯", f"Rewind Timer: {val}s", 1500)
            else:
                for item in state.get("queue", []):
                    item["expires_at"] = None
                show_osd("󰁯", "Rewind: Manual Mode", 1500)
        elif "--toggle-media" in args:
            curr = state.get("pause_media", True)
            new_val = not curr
            state["pause_media"] = new_val
            msg = "Auto-Pause Media: ON" if new_val else "Auto-Pause Media: OFF"
            show_osd("󰝚", msg, 1500)
        elif "--enable-media" in args:
            state["pause_media"] = True
            show_osd("󰝚", "Auto-Pause Media: ON", 1500)
        elif "--disable-media" in args:
            state["pause_media"] = False
            show_osd("󰝚", "Auto-Pause Media: OFF", 1500)

        sm.save(state)

    notify_shell_widget()


def action_clear():
    """Permanently closes any queued/hidden windows and clears the queue."""
    sm = StateManager()
    to_terminate = []
    with sm as state:
        for item in state.get("queue", []):
            addr = item.get("address")
            if addr:
                to_terminate.append(item)
        state["queue"] = []
        sm.save(state)

    for item in to_terminate:
        prepare_window_audio_for_close(item)
        terminate_window(item.get("address"), item.get("pid"))

    show_osd("󰅖", "Rewind: Cleared", 1200)
    notify_shell_widget()


