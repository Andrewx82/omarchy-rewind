BINDINGS_LUA = Path.home() / ".config" / "hypr" / "bindings.lua"

REWIND_BINDINGS_BLOCK = """
-- START: Rewind Plugin Keybindings
hl.unbind("SUPER + W")
o.bind("SUPER + W", "Close window (Rewind grace)", "rewind close")
o.bind("SUPER + U", "Rewind closed window", "rewind restore")
o.bind("SUPER + CTRL + U", "Toggle Rewind", "rewind toggle")
o.bind("SUPER + ALT + W", "Toggle Rewind", "rewind toggle")
o.bind("SUPER + SHIFT + U", "Rewind settings menu", "rewind menu")
-- END: Rewind Plugin Keybindings
"""


def are_bindings_installed() -> bool:
    if not BINDINGS_LUA.exists():
        return False
    try:
        content = BINDINGS_LUA.read_text(encoding="utf-8")
        return "rewind close" in content
    except Exception:
        return False


def action_setup():
    """Configures Hyprland keybindings in ~/.config/hypr/bindings.lua and ensures ~/.local/bin symlinks exist."""
    bin_dir = Path.home() / ".local" / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)
    target_bin = Path(__file__).resolve()
    for link_name in ("rewind", "omarchy-rewind"):
        link_path = bin_dir / link_name
        try:
            if link_path.is_symlink() or link_path.exists():
                link_path.unlink()
            link_path.symlink_to(target_bin)
        except Exception:
            pass

    BINDINGS_LUA.parent.mkdir(parents=True, exist_ok=True)
    if not BINDINGS_LUA.exists():
        BINDINGS_LUA.write_text("-- Personal keybinding overrides\n", encoding="utf-8")

    content = BINDINGS_LUA.read_text(encoding="utf-8")
    if "rewind close" in content:
        print("Keybindings are already configured in ~/.config/hypr/bindings.lua")
    else:
        with open(BINDINGS_LUA, "a", encoding="utf-8") as f:
            f.write(REWIND_BINDINGS_BLOCK)
        print("Added Rewind keybindings to ~/.config/hypr/bindings.lua")

    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    show_osd("󰁯", "Rewind: Shortcuts Enabled!", 1500)
    notify_shell_widget()


def action_remove_bindings(quiet=False):
    """Removes Rewind keybindings from ~/.config/hypr/bindings.lua and reloads Hyprland to restore defaults."""
    if BINDINGS_LUA.exists():
        try:
            content = BINDINGS_LUA.read_text(encoding="utf-8")

            # 1. Remove delimited block if present
            delimited_pattern = r"\n?-- START: Rewind Plugin Keybindings.*?-- END: Rewind Plugin Keybindings\n?"
            cleaned = re.sub(delimited_pattern, "", content, flags=re.DOTALL)

            # 2. Remove legacy block if present
            legacy_pattern = r"\n?-- Rewind Plugin:.*?rewind menu\"\)\n?"
            cleaned = re.sub(legacy_pattern, "", cleaned, flags=re.DOTALL)

            # 3. Remove any unbind("SUPER + W") directly preceding a rewind close binding
            cleaned = re.sub(
                r'hl\.unbind\s*\(\s*["\']SUPER \+ W["\']\s*\)\s*\n\s*o\.bind\s*\(\s*["\']SUPER \+ W["\']\s*,\s*[^,]+,\s*["\']rewind close["\']\s*\)\n?',
                '',
                cleaned
            )

            # 4. Final filter for any stray rewind lines
            lines = cleaned.splitlines()
            filtered = [
                line for line in lines
                if "rewind close" not in line
                and "rewind restore" not in line
                and "rewind toggle" not in line
                and "rewind menu" not in line
                and not line.strip().startswith("-- START: Rewind")
                and not line.strip().startswith("-- END: Rewind")
                and not line.strip().startswith("-- Rewind Plugin:")
            ]

            final_content = "\n".join(filtered).strip() + "\n"
            BINDINGS_LUA.write_text(final_content, encoding="utf-8")
            if not quiet:
                print("Removed Rewind keybindings from ~/.config/hypr/bindings.lua")
        except Exception as e:
            if not quiet:
                print(f"Error removing Rewind bindings: {e}")

    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not quiet:
        show_osd("󰁯", "Rewind: Default Shortcuts Restored", 1500)
        notify_shell_widget()


def action_uninstall():
    """Completely uninstalls Rewind: restores default shortcuts, removes symlinks, state, and plugin."""
    print("Uninstalling Rewind...")

    # 1. Restore keybindings and reload Hyprland
    action_remove_bindings(quiet=False)

    # 2. Remove ~/.local/bin symlinks
    bin_dir = Path.home() / ".local" / "bin"
    for link_name in ("rewind", "omarchy-rewind"):
        link_path = bin_dir / link_name
        try:
            if link_path.is_symlink() or link_path.exists():
                link_path.unlink()
                print(f"Removed symlink: {link_path}")
        except Exception as e:
            print(f"Notice: Could not remove {link_path}: {e}")

    # 3. Clean up state directory
    if STATE_DIR.exists():
        try:
            shutil.rmtree(STATE_DIR, ignore_errors=True)
            print(f"Cleaned up state directory: {STATE_DIR}")
        except Exception as e:
            print(f"Notice: Could not remove {STATE_DIR}: {e}")

    # 4. Remove plugin from Omarchy shell
    plugin_dir = Path.home() / ".config" / "omarchy" / "plugins" / "omarchy-rewind"
    try:
        res = subprocess.run(
            ["omarchy", "plugin", "remove", "omarchy-rewind", "--yes"],
            capture_output=True,
            text=True,
            timeout=10
        )
        if res.returncode == 0:
            print("Removed omarchy-rewind from Omarchy plugins.")
        else:
            if plugin_dir.exists():
                shutil.rmtree(plugin_dir, ignore_errors=True)
                subprocess.run(["omarchy-shell", "shell", "rescanPlugins"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(f"Removed {plugin_dir}")
    except Exception:
        if plugin_dir.exists():
            shutil.rmtree(plugin_dir, ignore_errors=True)
            subprocess.run(["omarchy-shell", "shell", "rescanPlugins"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"Removed {plugin_dir}")

    print("\nRewind has been successfully uninstalled.")
    print("Default Super+W window closing behavior has been restored.")


def action_status():
    """Outputs status JSON for scripts and widgets."""
    sm = StateManager()
    with sm as state:
        now = time.time()
        countdown_enabled = state.get("countdown_enabled", True)
        countdown_seconds = state.get("countdown_seconds", int(DEFAULT_GRACE_PERIOD))
        queue = state.get("queue", [])

        if countdown_enabled:
            queue = [item for item in queue if item.get("expires_at") and item.get("expires_at", 0) > now]
            for item in queue:
                item["remaining"] = max(0, int(item.get("expires_at", 0) - now))
        else:
            for item in queue:
                item["remaining"] = -1  # Indicates infinite / manual mode

        out = {
            "enabled": state.get("enabled", True),
            "countdown_enabled": countdown_enabled,
            "countdown_seconds": countdown_seconds,
            "pause_media": state.get("pause_media", True),
            "bindings_installed": are_bindings_installed(),
            "count": len(queue),
            "queue": queue,
            "last": queue[-1] if queue else None
        }
        print(json.dumps(out))


def main():
    if len(sys.argv) < 2:
        print("Usage: rewind <close|restore|toggle|clear|menu|setup|remove-bindings|uninstall|config ...|status>")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "close":
        action_close()
    elif cmd == "restore":
        action_restore()
    elif cmd == "toggle":
        action_toggle()
    elif cmd == "clear":
        action_clear()
    elif cmd in ("menu", "settings"):
        action_menu()
    elif cmd == "config":
        action_config(sys.argv[2:])
    elif cmd in ("setup", "install-bindings"):
        action_setup()
    elif cmd in ("remove-bindings", "uninstall-bindings", "restore-defaults"):
        action_remove_bindings()
    elif cmd == "uninstall":
        action_uninstall()
    elif cmd in ("status", "--status"):
        action_status()
    elif cmd in ("version", "-v", "--version"):
        print(VERSION)
    elif cmd == "--expire" and len(sys.argv) >= 5:
        action_expire(sys.argv[2], sys.argv[3], sys.argv[4])
    elif cmd == "--terminate" and len(sys.argv) >= 3:
        target_pid = None
        if len(sys.argv) >= 4 and sys.argv[3].isdigit():
            target_pid = int(sys.argv[3])
        terminate_window(sys.argv[2], target_pid)
    elif cmd in ("-h", "--help", "help"):
        print("Rewind - Window Grace Period & Undo Restore for Omarchy\n")
        print("Commands:")
        print("  close               Soft-close active window with Rewind grace period")
        print("  restore             Restore / rewind last closed window")
        print("  toggle              Toggle Rewind ON / OFF")
        print("  menu                Open settings popup on the status bar")
        print("  clear               Permanently terminate hidden windows")
        print("  setup               Configure shortcuts in ~/.config/hypr/bindings.lua")
        print("  remove-bindings     Remove shortcuts and restore Omarchy defaults")
        print("  uninstall           Completely uninstall Rewind and restore defaults")
        print("  config ...          Configure countdown grace & media auto-pause")
        print("  status              Output state JSON")
    else:
        print(f"Unknown command: {cmd}")
        print("Run 'rewind --help' for usage.")
        sys.exit(1)


